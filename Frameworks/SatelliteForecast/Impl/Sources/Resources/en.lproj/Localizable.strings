/* Satellite geographic context */
/* Current subsatellite location. %@ is a standalone geographic name; avoid grammatical inflection of inserted names. */
"geography.over" = "Over %@";
/* %1$@ is a sea/ocean; %2$@ is a nearby country/territory. Keep both placeholders; reorder as needed. */
"geography.waterNear" = "%1$@ · near %2$@";
/* No named marine region was found. %@ is a nearby country/territory, not the country being flown over. */
"geography.near" = "Near %@";
/* Shown and spoken when current satellite geography cannot be resolved. */
"geography.unavailable" = "Location unavailable";
/* Optional detailed description, not currently displayed on home. */
"geography.landDetail" = "Above land · Explore the ground track";
/* %@ is the standalone name of the country/territory with the nearest coast. */
"geography.coast" = "Near the coast: %@";
/* Optional detail: %1$@ is a localized number in km; %2$@ is the direction FROM the nearest coast TO the satellite; %3$@ is its country/territory. Use standalone noun labels to avoid declension. */
"geography.distance" = "About %1$@ km · %2$@ · nearest coast: %3$@";
/* Standalone compass direction, used in the optional distance detail. */
"geography.north" = "north";
/* Standalone compass direction, used in the optional distance detail. */
"geography.northeast" = "northeast";
/* Standalone compass direction, used in the optional distance detail. */
