<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>SatelliteOverview.alarmSettingsCell.description</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@alarmCount@</string>
		<key>alarmCount</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>other</key>
			<string>您有 %d 个待设提醒。</string>
			<key>zero</key>
			<string>您目前没有设置任何提醒。</string>
		</dict>
	</dict>
	<key>SatelliteOverview.ephemeridesManagerCell.title</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@ephemerideFileCount@</string>
		<key>ephemerideFileCount</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>other</key>
			<string>%d 个星历文件</string>
			<key>zero</key>
			<string>没有星历文件</string>
		</dict>
	</dict>
</dict>
</plist>
