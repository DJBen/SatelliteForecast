<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>SatelliteOverview.alarmSettingsCell.description</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@alarmCount@</string>
		<key>alarmCount</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>other</key>
			<string>%d個の保留中のアラームがあります。</string>
			<key>zero</key>
			<string>現在、アラームが設定されていません。</string>
		</dict>
	</dict>
	<key>SatelliteOverview.ephemeridesManagerCell.title</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@ephemerideFileCount@</string>
		<key>ephemerideFileCount</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>other</key>
			<string>%d個の軌道データファイル</string>
			<key>zero</key>
			<string>軌道データファイルがありません</string>
		</dict>
	</dict>
</dict>
</plist>
