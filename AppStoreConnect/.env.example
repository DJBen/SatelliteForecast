# Example environment variables for App Store Connect API
# Copy this to .env and fill in your actual values

# Your API Key ID (found in App Store Connect > Users and Access > Keys)
APP_STORE_CONNECT_API_KEY_ID=XXXXXXXXXX

# Your Issuer ID (found in App Store Connect > Users and Access > Keys)
APP_STORE_CONNECT_API_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Path to your .p8 private key file
APP_STORE_CONNECT_API_PRIVATE_KEY_PATH=/path/to/your/AuthKey_XXXXXXXXXX.p8
