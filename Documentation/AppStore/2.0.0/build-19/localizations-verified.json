    {
      "type": "appStoreVersionLocalizations",
      "id": "c6adc767-6087-46da-a8b3-e9fe45bdfbfc",
      "attributes": {
        "locale": "zh-Hans",
        "description": "\u77e5\u9053\u4f55\u65f6\u62ac\u5934\uff0c\u4e5f\u77e5\u9053\u671d\u54ea\u91cc\u770b\u3002\n\n\u5929\u5bab\u7a7a\u95f4\u7ad9\u8fc7\u5883\u5e2e\u52a9\u60a8\u5728\u6240\u9009\u5730\u70b9\u5bfb\u627e\u5929\u5bab\u7a7a\u95f4\u7ad9\u3001\u56fd\u9645\u7a7a\u95f4\u7ad9\u53ca\u5176\u4ed6\u536b\u661f\u3002\u901a\u8fc7\u8fc7\u5883\u9884\u6d4b\u3001\u4ea4\u4e92\u5f0f\u661f\u56fe\u548c\u63d0\u9192\uff0c\u63d0\u524d\u89c4\u5212\u4e0b\u4e00\u6b21\u89c2\u6d4b\u3002\n\n\u2022 \u5bfb\u627e\u4e0b\u4e00\u6b21\u53ef\u89c1\u8fc7\u5883\uff1a\u67e5\u770b\u8fc7\u5883\u65f6\u95f4\uff0c\u4e86\u89e3\u536b\u661f\u5c06\u5728\u5730\u5e73\u7ebf\u4e0a\u65b9\u5347\u5230\u591a\u9ad8\u3002\n\n\u2022 \u8ffd\u968f\u5212\u8fc7\u661f\u7a7a\u7684\u8f68\u8ff9\uff1a\u63a2\u7d22\u5305\u542b\u6052\u661f\u3001\u661f\u5ea7\u3001\u94f6\u6cb3\u548c\u6708\u4eae\u7684\u4ea4\u4e92\u5f0f\u661f\u56fe\u3002\n\n\u2022 \u638c\u63e1\u5173\u952e\u65f6\u523b\uff1a\u4e86\u89e3\u536b\u661f\u4f55\u65f6\u5347\u8d77\u3001\u4f55\u65f6\u5230\u8fbe\u53ef\u89c1\u8f68\u8ff9\u7684\u6700\u9ad8\u70b9\uff0c\u4ee5\u53ca\u4f55\u65f6\u6d88\u5931\u5728\u89c6\u91ce\u4e2d\u3002\n\n\u2022 \u8bbe\u7f6e\u89c2\u6d4b\u63d0\u9192\uff1a\u4e3a\u60f3\u770b\u7684\u8fc7\u5883\u5b89\u6392\u63d0\u9192\u3002\n\n\u2022 \u63a2\u7d22\u7a7a\u95f4\u7ad9\u4ee5\u5916\u7684\u536b\u661f\uff1a\u6d4f\u89c8\u6570\u5343\u9897\u536b\u661f\uff0c\u5305\u62ec\u660e\u4eae\u536b\u661f\u548c\u8fd1\u671f\u53d1\u5c04\u7684\u536b\u661f\u3002\n\n\u60a8\u8fd8\u53ef\u4ee5\u5728\u8bbe\u7f6e\u4e2d\u5f00\u542f\u5b9e\u9a8c\u6027\u7684\u5b9e\u65f6\u661f\u7a7a\u89c6\u56fe\u3002",
        "keywords": "\u5929\u5bab,iss,tiangong,\u56fd\u9645\u7a7a\u95f4\u7ad9,\u536b\u661f,\u8ffd\u8e2a,\u661f\u56fe,\u89c2\u661f,\u5929\u6587,\u8f68\u9053,\u63d0\u9192,\u89c2\u6d4b,\u661f\u7a7a,\u6708\u76f8",
        "marketingUrl": "https://space-station-passes.web.app/",
        "promotionalText": "\u4e0b\u4e00\u6b21\u7a7a\u95f4\u7ad9\u8fc7\u5883\uff0c\u63d0\u524d\u51c6\u5907\u3002\u67e5\u770b\u5929\u5bab\u548c\u56fd\u9645\u7a7a\u95f4\u7ad9\u7684\u53ef\u89c1\u8fc7\u5883\u65f6\u95f4\u4e0e\u661f\u7a7a\u8f68\u8ff9\uff0c\u8bbe\u7f6e\u63d0\u9192\uff0c\u628a\u63e1\u89c2\u6d4b\u65f6\u673a\u3002",
        "supportUrl": "https://space-station-passes.web.app/support",
        "whatsNew": "\u5168\u65b0\u7684\u201c\u4e0b\u6b21\u89c2\u6d4b\u201d\u4e3b\u9875\u3002\n\u2022 \u4e00\u773c\u770b\u5230\u5929\u5bab\u6216\u56fd\u9645\u7a7a\u95f4\u7ad9\u7684\u4e0b\u4e00\u6b21\u53ef\u89c1\u8fc7\u5883\uff0c\u5e76\u7528\u52a8\u6001\u661f\u7a7a\u9884\u89c8\u5c55\u793a\u5b83\u4ece\u54ea\u91cc\u5347\u8d77\u3001\u8fbe\u5230\u6700\u9ad8\u70b9\u548c\u843d\u4e0b\u3002\n\u2022 \u70b9\u6309\u201c\u63d0\u9192\u6211\u201d\uff0c\u5728\u6bcf\u6b21\u53ef\u89c1\u8fc7\u5883\u524d\u6536\u5230\u63a8\u9001\u63d0\u9192\u3002\n\u2022 \u4e3b\u5c4f\u5e55\u5c0f\u7ec4\u4ef6\u5c55\u793a\u4e0b\u4e00\u6b21\u8fc7\u5883\uff0c\u5305\u542b\u661f\u56fe\u4ee5\u53ca\u5347\u8d77\u3001\u6700\u9ad8\u70b9\u548c\u843d\u4e0b\u65f6\u95f4\u3002\n\u2022 \u5168\u90e8\u8fc7\u5883\u6309\u65e5\u671f\u5206\u7ec4\uff0c\u5e76\u663e\u793a\u7a7a\u95f4\u7ad9\u56fe\u6807\u548c\u6700\u9ad8\u4ef0\u89d2\u3002\n\u2022 \u901a\u8fc7\u5b9e\u65f6\u6d3b\u52a8\u8ddf\u8e2a\u8fc7\u5883\uff0c\u5305\u62ec\u9633\u5149\u4e0e\u5730\u5f71\u4e4b\u95f4\u7684\u53d8\u5316\u3002\n\u2022 \u8fc7\u5883\u671f\u95f4\uff0c\u4e3b\u9875\u663e\u793a\u536b\u661f\u7684\u5f53\u524d\u4f4d\u7f6e\u548c\u4ef0\u89d2\u3002\u661f\u8c61\u9986\u81ea\u52a8\u8fdb\u5165\u201c\u73b0\u5728\u201d\u6a21\u5f0f\uff0c\u5e76\u9192\u76ee\u5730\u6807\u793a\u6b63\u5728\u8fc7\u5883\u3002\n\u2022 \u6539\u5584\u4e86\u661f\u8c61\u9986\u7684\u54cd\u5e94\u901f\u5ea6\u3002"
      },
