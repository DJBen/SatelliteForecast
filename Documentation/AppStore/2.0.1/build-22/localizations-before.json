{
  "data": [
    {
      "type": "appStoreVersionLocalizations",
      "id": "4cb66de8-5de1-4a44-afc0-bef6e6c82458",
      "attributes": {
        "locale": "ko",
        "description": "\uc5b8\uc81c \ud558\ub298\uc744 \uc62c\ub824\ub2e4\ubcf4\uace0 \uc5b4\ub290 \ubc29\ud5a5\uc744 \ubd10\uc57c \ud560\uc9c0 \uc54c\uc544\ubcf4\uc138\uc694.\n\n\uc6b0\uc8fc\uc815\uac70\uc7a5 \ud1b5\uacfc\ub294 \uc120\ud0dd\ud55c \uc704\uce58\uc5d0\uc11c \uad6d\uc81c\uc6b0\uc8fc\uc815\uac70\uc7a5, \ud188\uad81 \ubc0f \ub2e4\ub978 \uc704\uc131\uc744 \ucc3e\ub3c4\ub85d \ub3c4\uc640\uc90d\ub2c8\ub2e4. \ud1b5\uacfc \uc608\uce21, \ub300\ud654\ud615 \ubcc4\uc9c0\ub3c4, \uc54c\ub9bc\uc73c\ub85c \ub2e4\uc74c \uad00\uce21\uc744 \uacc4\ud68d\ud558\uc138\uc694.\n\n\u2022 \ub2e4\uc74c \uad00\uce21 \uac00\ub2a5\ud55c \ud1b5\uacfc \ucc3e\uae30: \ud1b5\uacfc \uc2dc\uac01\uacfc \uc704\uc131\uc774 \uc9c0\ud3c9\uc120 \uc704\ub85c \uc5bc\ub9c8\ub098 \ub192\uc774 \uc62c\ub77c\uc624\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694.\n\n\u2022 \ud558\ub298\uc744 \uac00\ub85c\uc9c0\ub974\ub294 \uacbd\ub85c \ud655\uc778\ud558\uae30: \ubcc4, \ubcc4\uc790\ub9ac, \uc740\ud558\uc218, \ub2ec\uc774 \ud45c\uc2dc\ub418\ub294 \ub300\ud654\ud615 \ubcc4\uc9c0\ub3c4\ub97c \uc0b4\ud3b4\ubcf4\uc138\uc694.\n\n\u2022 \uc8fc\uc694 \uc21c\uac04 \uc54c\uc544\ubcf4\uae30: \uc704\uc131\uc774 \ub5a0\uc624\ub974\uace0, \ubcf4\uc774\ub294 \uad6c\uac04\uc5d0\uc11c \uac00\uc7a5 \ub192\uc740 \uc9c0\uc810\uc5d0 \ub3c4\ub2ec\ud558\uace0, \uc2dc\uc57c\uc5d0\uc11c \uc0ac\ub77c\uc9c0\ub294 \uc2dc\uac01\uc744 \ud655\uc778\ud558\uc138\uc694.\n\n\u2022 \uc54c\ub9bc \uc124\uc815\ud558\uae30: \uad00\uce21\ud558\uace0 \uc2f6\uc740 \ud1b5\uacfc\uc5d0 \ub9de\ucdb0 \uc54c\ub9bc\uc744 \uc608\uc57d\ud558\uc138\uc694.\n\n\u2022 \uc6b0\uc8fc\uc815\uac70\uc7a5 \ub108\uba38\ub85c \ud0d0\uc0c9\ud558\uae30: \ubc1d\uc740 \uc704\uc131\uacfc \ucd5c\uadfc \ubc1c\uc0ac\ub41c \uc704\uc131\uc744 \ud3ec\ud568\ud55c \uc218\ucc9c \uac1c\uc758 \uc704\uc131\uc744 \uc0b4\ud3b4\ubcf4\uc138\uc694.\n\n\uc124\uc815\uc5d0\uc11c \uc2e4\ud5d8\uc801\uc778 \uc2e4\uc2dc\uac04 \ud558\ub298 \ubcf4\uae30\ub97c \ucf24 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
        "keywords": "iss,tiangong,\uc704\uc131,\ucd94\uc801,\ucc9c\ubb38\ud559,\ubcc4\uc790\ub9ac,\ubcc4\uc9c0\ub3c4,\uada4\ub3c4,\uc54c\ub9bc,\uad00\uce21,\ud558\ub298",
        "marketingUrl": "https://space-station-passes.web.app/",
        "promotionalText": "\uba38\ub9ac \uc704\ub97c \uc9c0\ub098\ub294 ISS\uc640 \ud188\uad81\uc744 \ucc3e\uc544\ubcf4\uc138\uc694. \uad00\uce21 \uac00\ub2a5\ud55c \ud1b5\uacfc\uc640 \ubcc4 \uc0ac\uc774\uc758 \uc774\ub3d9 \uacbd\ub85c\ub97c \ud655\uc778\ud558\uace0 \ub2e4\uc74c \uad00\uce21\uc744 \uc704\ud55c \uc54c\ub9bc\uc744 \uc124\uc815\ud558\uc138\uc694.",
        "supportUrl": "https://space-station-passes.web.app/support"
      },
