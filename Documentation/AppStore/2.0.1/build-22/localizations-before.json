    {
      "type": "appStoreVersionLocalizations",
      "id": "de28cad8-f350-4f5a-89d8-75d07a7b5233",
      "attributes": {
        "locale": "ja",
        "description": "\u3044\u3064\u3001\u3069\u306e\u65b9\u89d2\u3092\u898b\u4e0a\u3052\u308c\u3070\u3088\u3044\u304b\u304c\u308f\u304b\u308a\u307e\u3059\u3002\n\n\u300c\u5b87\u5b99\u30b9\u30c6\u30fc\u30b7\u30e7\u30f3\u901a\u904e\u300d\u306f\u3001\u9078\u3093\u3060\u5834\u6240\u304b\u3089\u56fd\u969b\u5b87\u5b99\u30b9\u30c6\u30fc\u30b7\u30e7\u30f3\u3001\u5929\u5bae\u3001\u305d\u306e\u4ed6\u306e\u885b\u661f\u3092\u898b\u3064\u3051\u308b\u304a\u624b\u4f1d\u3044\u3092\u3057\u307e\u3059\u3002\u901a\u904e\u4e88\u6e2c\u3001\u30a4\u30f3\u30bf\u30e9\u30af\u30c6\u30a3\u30d6\u306a\u661f\u56f3\u3001\u30ea\u30de\u30a4\u30f3\u30c0\u30fc\u3067\u3001\u6b21\u306e\u89b3\u6e2c\u3092\u8a08\u753b\u3057\u307e\u3057\u3087\u3046\u3002\n\n\u2022 \u6b21\u306e\u89b3\u6e2c\u3067\u304d\u308b\u901a\u904e\u3092\u63a2\u3059\uff1a\u901a\u904e\u6642\u523b\u3068\u3001\u885b\u661f\u304c\u5730\u5e73\u7dda\u304b\u3089\u3069\u308c\u304f\u3089\u3044\u9ad8\u304f\u898b\u3048\u308b\u304b\u3092\u78ba\u8a8d\u3067\u304d\u307e\u3059\u3002\n\n\u2022 \u661f\u7a7a\u3092\u6a2a\u5207\u308b\u8ecc\u8de1\u3092\u305f\u3069\u308b\uff1a\u661f\u3001\u661f\u5ea7\u3001\u5929\u306e\u5ddd\u3001\u6708\u3092\u8868\u793a\u3059\u308b\u30a4\u30f3\u30bf\u30e9\u30af\u30c6\u30a3\u30d6\u306a\u661f\u56f3\u3092\u63a2\u7d22\u3067\u304d\u307e\u3059\u3002\n\n\u2022 \u5927\u5207\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u77e5\u308b\uff1a\u885b\u661f\u304c\u6607\u308b\u6642\u523b\u3001\u898b\u3048\u3066\u3044\u308b\u9593\u306e\u6700\u9ad8\u70b9\u306b\u9054\u3059\u308b\u6642\u523b\u3001\u898b\u3048\u306a\u304f\u306a\u308b\u6642\u523b\u3092\u78ba\u8a8d\u3067\u304d\u307e\u3059\u3002\n\n\u2022 \u30ea\u30de\u30a4\u30f3\u30c0\u30fc\u3092\u8a2d\u5b9a\u3059\u308b\uff1a\u89b3\u6e2c\u3057\u305f\u3044\u901a\u904e\u306b\u901a\u77e5\u3092\u8a2d\u5b9a\u3067\u304d\u307e\u3059\u3002\n\n\u2022 \u5b87\u5b99\u30b9\u30c6\u30fc\u30b7\u30e7\u30f3\u4ee5\u5916\u3082\u63a2\u3059\uff1a\u660e\u308b\u3044\u885b\u661f\u3084\u6700\u8fd1\u6253\u3061\u4e0a\u3052\u3089\u308c\u305f\u885b\u661f\u306a\u3069\u3001\u6570\u5343\u306e\u885b\u661f\u3092\u8abf\u3079\u3089\u308c\u307e\u3059\u3002\n\n\u8a2d\u5b9a\u3067\u306f\u3001\u5b9f\u9a13\u7684\u306a\u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u306e\u661f\u7a7a\u8868\u793a\u3092\u6709\u52b9\u306b\u3067\u304d\u307e\u3059\u3002",
        "keywords": "iss,tiangong,\u885b\u661f,\u8ffd\u8de1,\u661f\u7a7a,\u661f\u56f3,\u89b3\u6e2c,\u8ecc\u9053,\u901a\u77e5,\u30ea\u30de\u30a4\u30f3\u30c0\u30fc,\u5929\u4f53\u89b3\u6e2c",
        "marketingUrl": "https://space-station-passes.web.app/",
        "promotionalText": "\u982d\u4e0a\u3092\u901a\u904e\u3059\u308bISS\u3068\u5929\u5bae\u3092\u898b\u3064\u3051\u307e\u3057\u3087\u3046\u3002\u89b3\u6e2c\u3067\u304d\u308b\u901a\u904e\u3092\u8abf\u3079\u3001\u661f\u7a7a\u3092\u6a2a\u5207\u308b\u8ecc\u8de1\u3092\u78ba\u8a8d\u3057\u3001\u6b21\u306e\u89b3\u6e2c\u306b\u5411\u3051\u3066\u30ea\u30de\u30a4\u30f3\u30c0\u30fc\u3092\u8a2d\u5b9a\u3067\u304d\u307e\u3059\u3002",
