    {
      "type": "appStoreVersionLocalizations",
      "id": "f28723f9-aaff-40ec-9a58-2238691dc24e",
      "attributes": {
        "locale": "en-US",
        "description": "Know when to look up\u2014and where to look.\n\nSpace Station Passes helps you spot the International Space Station, Tiangong, and other satellites from your chosen location. Plan your next observation with pass forecasts, interactive sky charts, and reminders.\n\n\u2022 Find your next visible pass: See upcoming passes, their timing, and how high each satellite will appear above the horizon.\n\n\u2022 Follow the path across the sky: Explore interactive charts with stars, constellations, the Milky Way, and the Moon.\n\n\u2022 Know the key moments: Check when a satellite rises, reaches its highest visible point, and disappears from view.\n\n\u2022 Set a reminder: Schedule an alert for the pass you want to watch.\n\n\u2022 Explore beyond the space stations: Browse thousands of satellites, including bright satellites and recent launches.\n\nAn optional experimental realtime sky view is available in Settings.",
        "keywords": "iss,tiangong,satellite,tracker,astronomy,stargazing,sky,chart,orbit,alert,reminder,overhead,spotting",
        "marketingUrl": "https://space-station-passes.web.app/",
        "promotionalText": "Spot the ISS and Tiangong overhead. Find visible passes, follow their paths across the stars, and set reminders for your next observation.",
        "supportUrl": "https://space-station-passes.web.app/support"
      },
      "relationships": {
        "appScreenshotSets": {
